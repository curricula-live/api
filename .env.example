# Django app settings
APP_ENV=development
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver

# Browser origins allowed to call the API. Production should use the curricula.live
# frontend origins only; do not use a wildcard.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional transport-security overrides. Production defaults are enabled whenever
# APP_ENV=production, so these normally do not need to be set explicitly.
# DJANGO_SECURE_SSL_REDIRECT=true
# DJANGO_SESSION_COOKIE_SECURE=true
# DJANGO_CSRF_COOKIE_SECURE=true
# DJANGO_SECURE_HSTS_SECONDS=31536000
# DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# DJANGO_SECURE_HSTS_PRELOAD=false

# Local development: use any PostgreSQL provider through DATABASE_URL.
# Supabase's Session Pooler is one compatible option, but application code is not
# tied to Supabase and the provider may be replaced without changing settings.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
