# Django app settings
APP_ENV=development
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-generated-secret
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver


# Local development: use the Supabase Session pooler.
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace-with-database-password@REGION.pooler.supabase.com:5432/postgres?sslmode=require
